{
  "manifest_version": 3,
  "name": "testCode Manga Add",
  "version": "0.1.0",
  "description": "Register manga extraction rules and add manga to testCode.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://75k8hy94my-ui.github.io/testCode/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "漫画を登録" },
  "content_scripts": [{
    "matches": ["https://75k8hy94my-ui.github.io/testCode/reader.html*"],
    "js": ["content/testcode-content.js"],
    "run_at": "document_idle"
  }]
}